# Sinh giá trị bằng: npm run gen:secrets
# Mã hóa kho đề (32 byte base64). PHẢI giống nhau giữa lúc `npm run build:bank` và trên Vercel.
DATA_KEY=
# Ký cookie đăng nhập & token phiên thi (32 byte base64)
SESSION_SECRET=
# Mật khẩu truy cập (có thể nhiều mã, cách nhau bằng dấu phẩy; mỗi mã = 1 "người dùng" với quota riêng)
ACCESS_CODES=

# --- Tùy chọn ---
# Rate-limit toàn cục giữa các instance serverless (khuyến nghị bật; tạo DB miễn phí tại upstash.com / Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Hạn mức xem đáp án / mã truy cập
REVEAL_LIMIT_PER_MIN=30
REVEAL_LIMIT_PER_DAY=700
